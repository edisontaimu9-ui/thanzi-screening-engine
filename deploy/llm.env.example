# Local LLM settings (optional feature, D128-D133). EXAMPLE ONLY: copy to a file named .env next to your compose file,
# permissions 600, never commit it. Every line is optional; the values shown are the defaults unless marked.
# Nothing here is a secret except THANZI_LLM_API_KEY, which stays empty unless your model server needs one.

# The feature is OFF unless this is exactly 1.
THANZI_LLM_ENABLED=1

# --- Which server and model -------------------------------------------------------------------------------------
# Provider: ollama | llamacpp | openai_compat | mock   (mock = no model, for wiring tests only)
THANZI_LLM_PROVIDER=ollama
# Base URL only, no /api or /v1 path. Must be local or private (loopback, private IP, or a single-word name such as
# "ollama" on the compose network). A public address is refused unless THANZI_LLM_ALLOW_REMOTE=1 and https is used.
THANZI_LLM_ENDPOINT=http://ollama:11434
# Check `ollama list` for the exact tag on your server. Check the model's licence before use.
THANZI_LLM_MODEL=qwen2.5:1.5b
THANZI_LLM_API_KEY=

# --- Time limits (seconds) --------------------------------------------------------------------------------------
THANZI_LLM_CONNECT_TIMEOUT_S=3
THANZI_LLM_TIMEOUT_S=60            # one generation. Raise it on very slow CPUs; lower max tokens first
THANZI_LLM_HEALTH_TIMEOUT_S=2
THANZI_LLM_QUEUE_TIMEOUT_S=5       # how long a request waits for a free slot before the API answers 503 llm_busy

# --- Load limits (low-resource hardware) -------------------------------------------------------------------------
THANZI_LLM_MAX_CONCURRENCY=1       # keep at 1 on 4 GB machines
THANZI_LLM_MAX_RETRIES=1           # connection errors and 429/502/503/504 only
THANZI_LLM_RETRY_BACKOFF_S=0.5     # doubles on each retry, with a little random spread
THANZI_LLM_MAX_PROMPT_CHARS=8000
THANZI_LLM_MAX_RESPONSE_BYTES=1048576
THANZI_LLM_KEEP_ALIVE=5m           # Ollama only. 0 unloads the model after every call (saves RAM, slower next call)

# --- Generation -------------------------------------------------------------------------------------------------
THANZI_LLM_MAX_TOKENS=256
THANZI_LLM_TEMPERATURE=0.2
# THANZI_LLM_TOP_P=0.9
# THANZI_LLM_TOP_K=40
# THANZI_LLM_SEED=42               # fixed seed for repeatable test output
THANZI_LLM_CONTEXT_TOKENS=2048     # Ollama only. A llama.cpp server fixes its context at start-up (-c)
# THANZI_LLM_THINK=false           # Ollama only. Qwen3-style models: false turns off visible reasoning
THANZI_LLM_STRIP_REASONING=true    # also removes <think>...</think> from any reply

# --- Privacy ----------------------------------------------------------------------------------------------------
# Leave at 0. Setting 1 allows a non-local endpoint (https only) and needs the data protection review first.
THANZI_LLM_ALLOW_REMOTE=0

# ---------------------------------------------------------------------------------------------------------------
# Presets
#   Qwen3 small:    THANZI_LLM_MODEL=qwen3:1.7b   THANZI_LLM_THINK=false
#   Smallest:       THANZI_LLM_MODEL=qwen2.5:0.5b
#   llama.cpp:      THANZI_LLM_PROVIDER=llamacpp  THANZI_LLM_ENDPOINT=http://llamacpp:8080   (the model is chosen when
#                   llama-server starts, so THANZI_LLM_MODEL is only a label)
#   Other servers:  THANZI_LLM_PROVIDER=openai_compat  (LM Studio, vLLM, llama-cpp-python), key in THANZI_LLM_API_KEY
