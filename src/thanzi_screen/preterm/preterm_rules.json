{
  "source": "COIN 2017 Participants' Manual (Malawi), Sessions 2, 12, 19 and wall charts; Fenton 2025 guidance sheet",
  "birth_weight_class": [
    {
      "id": "ELBW",
      "max_g_exclusive": 1000
    },
    {
      "id": "VLBW",
      "max_g_exclusive": 1500
    },
    {
      "id": "LBW",
      "max_g_exclusive": 2500
    }
  ],
  "birth_size_for_ga": {
    "sga_below_z": -1.2816,
    "lga_above_z": 1.2816,
    "note": "10th/90th percentile; define at birth only (Fenton calculator)"
  },
  "feeding_frequency": [
    {
      "if": "bw<1500 or ga<32",
      "hours": 2
    },
    {
      "if": "otherwise",
      "hours": 3
    }
  ],
  "fluid_ml_per_kg_day": {
    "1": 60,
    "2": 90,
    "3": 120,
    "4": 150,
    "7_lbw_sga": 180,
    "note": "days 5-6 not stated in COIN; hold at 150"
  },
  "route": {
    "bw<1500_or_ga<32": {
      "d1_3": "tube",
      "d4_21": "tube_or_cup"
    },
    "bw1500_1800_or_ga32_34": {
      "d1_3": "tube_or_cup",
      "d4_21": "breast_else_cup"
    },
    "bw>1800_or_ga>34": {
      "d1_3": "breast_else_cup",
      "d4_21": "breast"
    },
    "note": "coordinated suck-swallow ~34 wk; babies >1500 g and >=32 wk put to breast 5-10 min around tube/cup feeds"
  },
  "tube_feed_aspirate_review_pct": 25,
  "weight_pattern": {
    "max_loss_pct_week1": 15,
    "regain_birthweight_by_day": 14,
    "sga_expected_loss": "none"
  },
  "kmc": {
    "facility_below_g": 1500,
    "ambulatory_g": [
      1500,
      1800
    ],
    "community_above_g": 1800,
    "continuous_at_or_below_g": 2000
  },
  "hospitalise_if": [
    "sick",
    "not_gaining_weight",
    "cannot_feed_breast_or_cup"
  ],
  "home_management_min_g": 1800,
  "discharge_all_of": [
    "fully_breastfed_or_ebm_cup",
    "gaining_3_consecutive_days",
    "no_apnoea_7_days",
    "stable_temperature",
    "mother_confident"
  ],
  "followup": {
    "weekly_until_kg": 2.5
  },
  "supplements": {
    "vitamin_k_mg_im_birth": 0.5,
    "multivitamin_ml_day": [
      0.3,
      0.6
    ],
    "multivitamin_start": "full_feeds",
    "multivitamin_until_months": 6,
    "iron_mg_per_kg_day": [
      2,
      4
    ],
    "iron_start_weeks": 2,
    "iron_until_months": 6
  },
  "phototherapy_preterm_lt35wk_umol_l": {
    "day2": 170,
    "day3": 260,
    "day4_plus": 290,
    "day1": "any visible jaundice"
  },
  "growth_assessment": {
    "use_trajectory_not_single_point": true,
    "min_interval_days": 7,
    "language": "faltering growth (not failure)",
    "correct_age_until_years": 3,
    "fenton_max_pma_weeks": 50,
    "z_decline_tiers": {
      "mild": 0.8,
      "moderate": 1.2,
      "severe": 2.0,
      "note": "Literature-based (weight/length: mild 0.8-1.2, moderate >1.2-2, severe >=2). Not COIN. No universal cut-off per Fenton; use as review flags, not diagnoses. Needs clinician sign-off."
    },
    "hc_decline": {
      "follow_up_above": 1.0,
      "refer_above": 2.0
    },
    "min_age_days": 14
  },
  "hand_over_to_under5_engine": {
    "at_pma_weeks": 50,
    "use": "corrected age with WHO standards"
  },
  "urgent_triggers": {
    "note": "Danger-sign based; growth alone is never urgent. [COIN] = in manual; [proposed] = needs sign-off vs national neonatal guidelines / under-5 emergency signs.",
    "rules": [
      {"id": "bilious_vomiting", "all_of": ["bilious_vomiting"], "label": "bilious vomiting", "tag": "COIN"},
      {"id": "convulsions", "all_of": ["convulsions"], "label": "convulsions", "tag": "proposed"},
      {"id": "apnoea_now", "all_of": ["apnoea_now"], "label": "apnoea now", "tag": "proposed"},
      {"id": "cyanosis", "all_of": ["cyanosis"], "label": "cyanosis", "tag": "proposed"},
      {"id": "hypoglycaemia_uncorrected", "all_of": ["hypoglycaemia_uncorrected"], "label": "hypoglycaemia not correcting", "tag": "proposed"},
      {"id": "abdominal_distension_with_blood_or_intolerance", "all_of": ["abdominal_distension"], "any_of": ["blood_in_stool", "feed_intolerance"], "label": "abdominal distension with blood in stool/feed intolerance", "tag": "proposed"},
      {"id": "cannot_feed_with_dehydration_or_lethargy", "all_of": ["cannot_feed"], "any_of": ["dehydrated", "lethargic"], "label": "cannot feed and dehydrated/lethargic", "tag": "proposed"}
    ],
    "rules_note": "Single source of truth for the urgent triggers. Each rule fires when every field in all_of is true and, if any_of is given, at least one field in any_of is true. Field names are PretermInput attributes. Change triggers here, not in engine.py.",
    "stabilise_before_transfer": [
      "Keep warm (KMC or warm wrap)",
      "Check/correct airway, breathing, circulation and blood glucose",
      "Give first dose of antibiotics",
      "Write referral note; send all investigations; mother accompanies baby",
      "Keep feeding or fluids going during transport unless contraindicated"
    ]
  }
}