      "ScreenRequest": {
        "additionalProperties": false,
        "properties": {
          "age_days": {
            "description": "Age in whole days. No date of birth is accepted.",
            "title": "Age Days",
            "type": "integer"
          },
          "apnoea_last_7_days": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Preterm route: apnoea in the last 7 days.",
            "title": "Apnoea Last 7 Days"
          },
          "appetite": {
            "default": "not_done",
            "enum": [
              "passed",
              "failed",
              "not_done"
            ],
            "title": "Appetite",
            "type": "string"
          },
          "birth_hc_cm": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Head circumference at birth, cm. Preterm route only; needed for the head-growth trend.",
            "title": "Birth Hc Cm"
          },
          "birth_length_cm": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Length at birth, cm. Preterm route only; needed for the length trend.",
            "title": "Birth Length Cm"
          },
          "birth_weight_g": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Birth weight in GRAMS (weight_kg is kilograms).",
            "title": "Birth Weight G"
          },
          "clinically_well_and_alert": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Clinically Well And Alert"
          },
          "complications": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "hypoglycaemia",
                    "hypothermia",
                    "infections",
                    "severe_dehydration",
                    "shock",
                    "very_severe_anaemia",
                    "cardiac_failure",
                    "severe_dermatosis",
                    "vitamin_a_deficiency_signs",
                    "diarrhoea",
                    "malaria"
                  ],
                  "type": "string"
                },
                "maxItems": 30,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "null: not assessed. []: assessed, none present.",
            "title": "Complications"
          },
          "consecutive_days_gaining_weight": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Preterm route: consecutive days of weight gain. If null and failure_to_gain_weight is true, 0 is used.",
            "title": "Consecutive Days Gaining Weight"
          },
          "danger_signs": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "anorexia",
                    "intractable_vomiting",
                    "convulsions",
                    "lethargy_not_alert",
                    "unconsciousness",
                    "unable_to_drink_or_breastfeed",
                    "high_fever"
                  ],
                  "type": "string"
                },
                "maxItems": 30,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "null: not assessed. []: assessed, none present.",
            "title": "Danger Signs"
          },
          "failure_to_gain_weight": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure To Gain Weight"
          },
          "gastric_aspirate_pct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Preterm route: gastric aspirate as % of the last tube feed (0 to 100).",
            "title": "Gastric Aspirate Pct"
          },
          "gestational_age_weeks": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Gestational age at birth, decimal weeks (22 to 44). With birth_weight_g it decides routing: born under 37 weeks or under 2500 g goes to the preterm engine until 50 weeks post-menstrual age, then to the under-5 engine on corrected age.",
            "title": "Gestational Age Weeks"
          },
          "hc_cm": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Head circumference, cm. Preterm route only.",
            "title": "Hc Cm"
          },
          "hiv_positive": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional and sensitive. Never echoed in worker responses.",
            "title": "Hiv Positive"
          },
          "hypoglycaemia_not_correcting": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Preterm route: hypoglycaemia is not correcting with treatment (the urgent trigger). The complications value hypoglycaemia is itself an urgent trigger on the preterm route (CMAM 2016 Table 5: inpatient).",
            "title": "Hypoglycaemia Not Correcting"
          },
          "length_height_cm": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Required for the under-5 flow. Optional only when the baby is screened by the preterm engine (born under 37 weeks or under 2500 g, under 50 weeks post-menstrual age); the length z-score is skipped without it.",
            "title": "Length Height Cm"
          },
          "measure_position": {
            "anyOf": [
              {
                "enum": [
                  "length",
                  "height"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Required whenever length_height_cm is given. Must be length on the preterm route.",
            "title": "Measure Position"
          },
          "muac_cm": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "6-59 months only. null: not measured.",
            "title": "Muac Cm"
          },
          "neonatal_danger_signs": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "bilious_vomiting",
                    "apnoea",
                    "cyanosis",
                    "abdominal_distension",
                    "blood_in_stool",
                    "feed_intolerance"
                  ],
                  "type": "string"
                },
                "maxItems": 30,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Preterm route: signs the CMAM danger-sign list does not have. null: not assessed. []: assessed, none present. Convulsions, lethargy, hypoglycaemia, severe dehydration and unable to feed are read from danger_signs, complications and too_weak_to_suckle, not asked twice.",
            "title": "Neonatal Danger Signs"
          },
          "oedema": {
            "description": "Required: it is never assumed to be absent.",
            "enum": [
              "none",
              "+",
              "++",
              "+++"
            ],
            "title": "Oedema",
            "type": "string"
          },
          "sex": {
            "enum": [
              "male",
              "female"
            ],
            "title": "Sex",
            "type": "string"
          },
          "sick": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Preterm route: clinician judges the baby sick (hospitalise).",
            "title": "Sick"
          },
          "temperature_unstable": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Preterm route: unstable temperature.",
            "title": "Temperature Unstable"
          },
          "too_weak_to_suckle": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Too Weak To Suckle"
          },
          "visible_severe_wasting": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Visible Severe Wasting"
          },
          "weight_kg": {
            "title": "Weight Kg",
            "type": "number"
          }
        },
        "required": [
          "sex",
          "age_days",
          "weight_kg",
          "oedema"
        ],
        "title": "ScreenRequest",
        "type": "object"
      },
      "VersionResponse": {
        "properties": {
          "api_version": {
            "title": "Api Version",
            "type": "string"
          },
          "disclaimer": {
            "title": "Disclaimer",
            "type": "string"
          },
          "engine_version": {
            "title": "Engine Version",
            "type": "string"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "rule_set_version": {
            "title": "Rule Set Version",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "api_version",
          "engine_version",
          "rule_set_version",
          "model_version",
          "status",
          "disclaimer"
        ],
        "title": "VersionResponse",
        "type": "object"
      },
      "WorkerResponse": {
        "properties": {
          "birth_context": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BirthContext"
              },
              {
                "type": "null"
              }
            ]
          },
          "classification": {
            "title": "Classification",
            "type": "string"
          },
          "clinical_assessment": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ClinicalAssessment"
              },
              {
                "type": "null"
              }
            ],
            "description": "Only when a baby under 2500 g has no gestational age: flagged for clinical assessment."
          },
          "disclaimer": {
            "title": "Disclaimer",
            "type": "string"
          },
          "ml_flags": {
            "$ref": "#/components/schemas/MlFlagsOut"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "programme": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "null for every MAM child: the programme is shown in the audit view only.",
            "title": "Programme"
          },
          "reasons": {
            "items": {
              "$ref": "#/components/schemas/CodeMessage"
            },
            "title": "Reasons",
            "type": "array"
          },
          "route": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Only when birth context was given: under5 or under5_corrected_age.",
            "title": "Route"
          },
          "rule_set_version": {
            "title": "Rule Set Version",
            "type": "string"
          },
          "rules_fired": {
            "description": "Display codes. MAM.HIV_OTP and MAM.SFP both show as MAM.REFER.",
            "items": {
              "type": "string"
            },
            "title": "Rules Fired",
            "type": "array"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "tier": {
            "title": "Tier",
            "type": "string"
          },
          "view": {
            "default": "worker",
            "title": "View",
            "type": "string"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          },
          "worker_summary": {
            "description": "2-3 lines. Never contains HIV information.",
            "items": {
              "type": "string"
            },
            "title": "Worker Summary",
            "type": "array"
          }
        },
        "required": [
          "worker_summary",
          "classification",
          "tier",
          "programme",
          "rules_fired",
          "reasons",
          "warnings",
          "ml_flags",
          "rule_set_version",
          "model_version",
          "status",
          "disclaimer"
        ],
        "title": "WorkerResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "GatewayKey": {
        "in": "header",
        "name": "X-Gateway-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Decision support for under-five malnutrition screening (CMAM 2016). Not a diagnosis. Babies born under 37 weeks or under 2500 g are routed to the preterm engine (Fenton 2025, CC BY-NC-ND 4.0) until 50 weeks post-menstrual age, then screened on corrected age. Demonstration only: synthetic data, not validated on real children. Stateless. Sits behind the gateway: every route except /health needs X-Gateway-Key.",
    "title": "Thanzi screening engine API",
    "version": "0.7.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "No credential needed and nothing else returned, so a container health check works.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "ops"
        ]
      }
    },
    "/v1/screen": {
      "post": {
        "description": "Screen one child. Worker view never contains HIV information. Audit view needs X-Audit-Key.",
        "operationId": "screen_v1_screen_post",
        "parameters": [
          {
            "in": "query",
            "name": "view",
            "required": false,
            "schema": {
              "default": "worker",
              "enum": [
                "worker",
                "audit"
              ],
              "title": "View",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Audit-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Audit-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScreenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/WorkerResponse"
                    },
                    {
                      "$ref": "#/components/schemas/AuditResponse"
                    },
                    {
                      "$ref": "#/components/schemas/PretermResponse"
                    },
                    {
                      "$ref": "#/components/schemas/PretermAuditResponse"
                    }
                  ],
                  "title": "Response 200 Screen V1 Screen Post"
                }
              }
            },
            "description": "Worker view by default. view=audit returns the audit view. A baby routed to the preterm engine gets the preterm response (route=preterm)."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Forbidden"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Request Entity Too Large"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "security": [
          {
            "GatewayKey": []
          }
        ],
        "summary": "Screen",
        "tags": [
          "screen"
        ]
      }
    },
    "/version": {
      "get": {
        "operationId": "version_version_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "GatewayKey": []
          }
        ],
        "summary": "Version",
        "tags": [
          "ops"
        ]
      }
    }
  }
}
