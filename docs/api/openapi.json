{
  "components": {
    "schemas": {
      "AuditResponse": {
        "properties": {
          "classification": {
            "title": "Classification",
            "type": "string"
          },
          "disclaimer": {
            "title": "Disclaimer",
            "type": "string"
          },
          "explanation": {
            "additionalProperties": true,
            "description": "Full Phase 5 Explanation: traces, contributions, margins, audit notes.",
            "title": "Explanation",
            "type": "object"
          },
          "ml_flags": {
            "$ref": "#/components/schemas/MlFlagsOut"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "programme": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Programme"
          },
          "reasons": {
            "items": {
              "$ref": "#/components/schemas/CodeMessage"
            },
            "title": "Reasons",
            "type": "array"
          },
          "referral_text": {
            "description": "Raw Phase 2 referral text. May contain HIV information.",
            "title": "Referral Text",
            "type": "string"
          },
          "rule_set_version": {
            "title": "Rule Set Version",
            "type": "string"
          },
          "rules_fired": {
            "description": "Real engine rule codes.",
            "items": {
              "type": "string"
            },
            "title": "Rules Fired",
            "type": "array"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "tier": {
            "title": "Tier",
            "type": "string"
          },
          "view": {
            "default": "audit",
            "title": "View",
            "type": "string"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          },
          "worker_summary": {
            "description": "2-3 lines. Never contains HIV information.",
            "items": {
              "type": "string"
            },
            "title": "Worker Summary",
            "type": "array"
          }
        },
        "required": [
          "worker_summary",
          "classification",
          "tier",
          "programme",
          "rules_fired",
          "reasons",
          "warnings",
          "ml_flags",
          "rule_set_version",
          "model_version",
          "status",
          "disclaimer",
          "referral_text",
          "explanation"
        ],
        "title": "AuditResponse",
        "type": "object"
      },
      "CodeMessage": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "CodeMessage",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "fields": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fields"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "description": "ok, or degraded when the ML models are missing or mismatched.",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "MlFlagsOut": {
        "properties": {
          "advisory": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Advisory"
          },
          "available": {
            "description": "false in degraded mode (models missing or mismatched).",
            "title": "Available",
            "type": "boolean"
          },
          "recording_error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RecordingError"
              },
              {
                "type": "null"
              }
            ]
          },
          "review": {
            "$ref": "#/components/schemas/Review"
          }
        },
        "required": [
          "available",
          "recording_error",
          "review"
        ],
        "title": "MlFlagsOut",
        "type": "object"
      },
      "RecordingError": {
        "properties": {
          "flagged": {
            "title": "Flagged",
            "type": "boolean"
          },
          "messages": {
            "items": {
              "type": "string"
            },
            "title": "Messages",
            "type": "array"
          },
          "probability": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Audit view only.",
            "title": "Probability"
          },
          "suggested_field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Suggested Field"
          }
        },
        "required": [
          "flagged",
          "suggested_field",
          "messages"
        ],
        "title": "RecordingError",
        "type": "object"
      },
      "Review": {
        "properties": {
          "needed": {
            "title": "Needed",
            "type": "boolean"
          },
          "reasons": {
            "items": {
              "$ref": "#/components/schemas/CodeMessage"
            },
            "title": "Reasons",
            "type": "array"
          }
        },
        "required": [
          "needed",
          "reasons"
        ],
        "title": "Review",
        "type": "object"
      },
      "ScreenRequest": {
        "additionalProperties": false,
        "properties": {
          "age_days": {
            "description": "Age in whole days. No date of birth is accepted.",
            "title": "Age Days",
            "type": "integer"
          },
          "appetite": {
            "default": "not_done",
            "enum": [
              "passed",
              "failed",
              "not_done"
            ],
            "title": "Appetite",
            "type": "string"
          },
          "clinically_well_and_alert": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Clinically Well And Alert"
          },
          "complications": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "hypoglycaemia",
                    "hypothermia",
                    "infections",
                    "severe_dehydration",
                    "shock",
                    "very_severe_anaemia",
                    "cardiac_failure",
                    "severe_dermatosis",
                    "vitamin_a_deficiency_signs",
                    "diarrhoea",
                    "malaria"
                  ],
                  "type": "string"
                },
                "maxItems": 30,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "null: not assessed. []: assessed, none present.",
            "title": "Complications"
          },
          "danger_signs": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "anorexia",
                    "intractable_vomiting",
                    "convulsions",
                    "lethargy_not_alert",
                    "unconsciousness",
                    "unable_to_drink_or_breastfeed",
                    "high_fever"
                  ],
                  "type": "string"
                },
                "maxItems": 30,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "null: not assessed. []: assessed, none present.",
            "title": "Danger Signs"
          },
          "failure_to_gain_weight": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure To Gain Weight"
          },
          "hiv_positive": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional and sensitive. Never echoed in worker responses.",
            "title": "Hiv Positive"
          },
          "length_height_cm": {
            "title": "Length Height Cm",
            "type": "number"
          },
          "measure_position": {
            "enum": [
              "length",
              "height"
            ],
            "title": "Measure Position",
            "type": "string"
          },
          "muac_cm": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "6-59 months only. null: not measured.",
            "title": "Muac Cm"
          },
          "oedema": {
            "description": "Required: it is never assumed to be absent.",
            "enum": [
              "none",
              "+",
              "++",
              "+++"
            ],
            "title": "Oedema",
            "type": "string"
          },
          "sex": {
            "enum": [
              "male",
              "female"
            ],
            "title": "Sex",
            "type": "string"
          },
          "too_weak_to_suckle": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Too Weak To Suckle"
          },
          "visible_severe_wasting": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Visible Severe Wasting"
          },
          "weight_kg": {
            "title": "Weight Kg",
            "type": "number"
          }
        },
        "required": [
          "sex",
          "age_days",
          "weight_kg",
          "length_height_cm",
          "measure_position",
          "oedema"
        ],
        "title": "ScreenRequest",
        "type": "object"
      },
      "VersionResponse": {
        "properties": {
          "api_version": {
            "title": "Api Version",
            "type": "string"
          },
          "disclaimer": {
            "title": "Disclaimer",
            "type": "string"
          },
          "engine_version": {
            "title": "Engine Version",
            "type": "string"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "rule_set_version": {
            "title": "Rule Set Version",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "api_version",
          "engine_version",
          "rule_set_version",
          "model_version",
          "status",
          "disclaimer"
        ],
        "title": "VersionResponse",
        "type": "object"
      },
      "WorkerResponse": {
        "properties": {
          "classification": {
            "title": "Classification",
            "type": "string"
          },
          "disclaimer": {
            "title": "Disclaimer",
            "type": "string"
          },
          "ml_flags": {
            "$ref": "#/components/schemas/MlFlagsOut"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "programme": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "null for every MAM child: the programme is shown in the audit view only.",
            "title": "Programme"
          },
          "reasons": {
            "items": {
              "$ref": "#/components/schemas/CodeMessage"
            },
            "title": "Reasons",
            "type": "array"
          },
          "rule_set_version": {
            "title": "Rule Set Version",
            "type": "string"
          },
          "rules_fired": {
            "description": "Display codes. MAM.HIV_OTP and MAM.SFP both show as MAM.REFER.",
            "items": {
              "type": "string"
            },
            "title": "Rules Fired",
            "type": "array"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "tier": {
            "title": "Tier",
            "type": "string"
          },
          "view": {
            "default": "worker",
            "title": "View",
            "type": "string"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          },
          "worker_summary": {
            "description": "2-3 lines. Never contains HIV information.",
            "items": {
              "type": "string"
            },
            "title": "Worker Summary",
            "type": "array"
          }
        },
        "required": [
          "worker_summary",
          "classification",
          "tier",
          "programme",
          "rules_fired",
          "reasons",
          "warnings",
          "ml_flags",
          "rule_set_version",
          "model_version",
          "status",
          "disclaimer"
        ],
        "title": "WorkerResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "GatewayKey": {
        "in": "header",
        "name": "X-Gateway-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Decision support for under-five malnutrition screening (CMAM 2016). Not a diagnosis. Demonstration only: synthetic data, not validated on real children. Stateless. Sits behind the gateway: every route except /health needs X-Gateway-Key.",
    "title": "Thanzi screening engine API",
    "version": "0.6.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "No credential needed and nothing else returned, so a container health check works.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "ops"
        ]
      }
    },
    "/v1/screen": {
      "post": {
        "description": "Screen one child. Worker view never contains HIV information. Audit view needs X-Audit-Key.",
        "operationId": "screen_v1_screen_post",
        "parameters": [
          {
            "in": "query",
            "name": "view",
            "required": false,
            "schema": {
              "default": "worker",
              "enum": [
                "worker",
                "audit"
              ],
              "title": "View",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Audit-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Audit-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScreenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/WorkerResponse"
                    },
                    {
                      "$ref": "#/components/schemas/AuditResponse"
                    }
                  ],
                  "title": "Response 200 Screen V1 Screen Post"
                }
              }
            },
            "description": "Worker view by default. view=audit returns the audit view."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Forbidden"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Request Entity Too Large"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "security": [
          {
            "GatewayKey": []
          }
        ],
        "summary": "Screen",
        "tags": [
          "screen"
        ]
      }
    },
    "/version": {
      "get": {
        "operationId": "version_version_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "GatewayKey": []
          }
        ],
        "summary": "Version",
        "tags": [
          "ops"
        ]
      }
    }
  }
}
